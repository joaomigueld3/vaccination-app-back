{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "linebreak-style": ["error", "unix"],
    "import/extensions": ["error", "ignorePackages", { "js": "always" }],
    "class-methods-use-this": "off",
    "consistent-return": "off",
    "no-plusplus": "off",
    "no-console": ["warn", { "allow": ["error", "info"] }],
    "no-param-reassign": "off",
    "eqeqeq": "error"
  }
}
